{
  "appId": "com.conectados.factura",
  "productName": "Conectados Factura+",
  "copyright": "Copyright © 2026 Conectados",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "dist/**/*",
    "main.cjs",
    "preload.cjs",
    "assets/**/*"
  ],
  "extraResources": [
    {
      "from": "assets",
      "to": "assets"
    }
  ],
  "asar": true,
  "compression": "maximum",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.png",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Conectados Factura+",
    "include": "assets/installer.nsh",
    "license": "assets/LICENSE.txt"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "assets/icons/mac/icon_512x512.png",
    "category": "public.app-category.business",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "assets/entitlements.plist",
    "entitlementsInherit": "assets/entitlements.plist"
  },
  "dmg": {
    "sign": false,
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "rpm",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icons",
    "category": "Office",
    "maintainer": "Conectados <conectados@chathannah.uk>",
    "vendor": "Conectados",
    "synopsis": "Sistema de facturación electrónica y gestión de stock",
    "description": "Conectados Factura+ - Sistema híbrido de facturación electrónica con soporte offline y sincronización en la nube",
    "desktop": {
      "Name": "Conectados Factura+",
      "Comment": "Sistema de facturación electrónica",
      "Categories": "Office;Finance;"
    }
  },
  "publish": {
    "provider": "github",
    "owner": "comultiservicio",
    "repo": "conectados-factura",
    "releaseType": "release"
  }
}
