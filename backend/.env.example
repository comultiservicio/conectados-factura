PORT=3001

# SECURITY: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# This is REQUIRED - server will not start without a real JWT_SECRET
JWT_SECRET=GENERATE_WITH_crypto_randomBytes_64_hex_AND_REPLACE_THIS

JWT_EXPIRES_IN=24h
DB_PATH=./data/factura.db
NODE_ENV=production

# ============================================================================
# AFIP (Administración Federal de Ingresos Públicos) - Factura Electrónica
# ============================================================================

# CUIT del emisor (11 dígitos, sin guiones)
AFIP_CUIT=20123456789

# Ambiente: 'homo' (homologación/pruebas) o 'prod' (producción real)
AFIP_ENV=homo

# Ruta a los certificados digitales AFIP
# Los archivos deben llamarse: cert.pem y key.pem
AFIP_CERTS_PATH=./certs

# Punto de venta por defecto
AFIP_DEFAULT_POS=1

# Ejemplo de configuración para producción:
# AFIP_CUIT=30123456789
# AFIP_ENV=prod
# AFIP_CERTS_PATH=./certs/prod